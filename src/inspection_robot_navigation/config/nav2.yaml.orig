global_costmap:
  global_costmap:
    ros__parameters:
      use_sim_time: false

      global_frame: map
      robot_base_frame: base_footprint
      transform_tolerance: 0.30

      update_frequency: 2.0
      publish_frequency: 1.0
      resolution: 0.05

      rolling_window: false
      track_unknown_space: true
      always_send_full_costmap: true

      footprint: "[[-0.320, -0.325], [-0.320, 0.325], [0.330, 0.325], [0.330, -0.325]]"
      footprint_padding: 0.02

      plugins:
        - static_layer
        - obstacle_layer
        - inflation_layer

      static_layer:
        plugin: "nav2_costmap_2d::StaticLayer"
        map_subscribe_transient_local: true

      obstacle_layer:
        plugin: "nav2_costmap_2d::ObstacleLayer"
        enabled: true
        observation_sources: scan

        scan:
          topic: /scan
          data_type: LaserScan
          clearing: true
          marking: true
          inf_is_valid: true

          obstacle_min_range: 0.15
          obstacle_max_range: 8.0
          raytrace_min_range: 0.15
          raytrace_max_range: 10.0

          min_obstacle_height: 0.0
          max_obstacle_height: 2.0

      inflation_layer:
        plugin: "nav2_costmap_2d::InflationLayer"
        inflation_radius: 0.55
        cost_scaling_factor: 3.0


local_costmap:
  local_costmap:
    ros__parameters:
      use_sim_time: false

      global_frame: odom
      robot_base_frame: base_footprint
      transform_tolerance: 0.30

      update_frequency: 8.0
      publish_frequency: 4.0
      resolution: 0.05

      rolling_window: true
      width: 4.0
      height: 4.0
      always_send_full_costmap: true

      footprint: "[[-0.320, -0.325], [-0.320, 0.325], [0.330, 0.325], [0.330, -0.325]]"
      footprint_padding: 0.02

      plugins:
        - obstacle_layer
        - voxel_layer
        - inflation_layer

      obstacle_layer:
        plugin: "nav2_costmap_2d::ObstacleLayer"
        enabled: true
        observation_sources: scan

        scan:
          topic: /scan
          data_type: LaserScan
          clearing: true
          marking: true
          inf_is_valid: true

          obstacle_min_range: 0.15
          obstacle_max_range: 3.0
          raytrace_min_range: 0.15
          raytrace_max_range: 3.5

          min_obstacle_height: 0.0
          max_obstacle_height: 2.0

      voxel_layer:
        plugin: "nav2_costmap_2d::VoxelLayer"
        enabled: true

        publish_voxel_map: true
        origin_z: 0.0
        z_resolution: 0.10
        z_voxels: 16
        mark_threshold: 0

        observation_sources: depth_cloud

        depth_cloud:
          topic: /camera/depth/points_filtered
          data_type: PointCloud2
          clearing: true
          marking: true

          min_obstacle_height: 0.03
          max_obstacle_height: 1.60

          obstacle_min_range: 0.10
          obstacle_max_range: 3.0
          raytrace_min_range: 0.10
          raytrace_max_range: 3.2

      inflation_layer:
        plugin: "nav2_costmap_2d::InflationLayer"
        inflation_radius: 0.55
        cost_scaling_factor: 3.0
planner_server:
  ros__parameters:
    use_sim_time: false

    expected_planner_frequency: 2.0
    planner_plugins:
      - Lattice

    Lattice:
      plugin: "nav2_smac_planner/SmacPlannerLattice"

      # Humble自带的差速/滑移转向运动原语：
      # 5cm栅格分辨率、0.5m最小转弯半径。
      lattice_filepath: "/opt/ros/humble/share/nav2_smac_planner/sample_primitives/5cm_resolution/0.5m_turning_radius/diff/output.json"

      tolerance: 0.25
      allow_unknown: true

      max_iterations: 100000
      max_on_approach_iterations: 1000
      max_planning_time: 2.0

      cache_obstacle_heuristic: true
      lookup_table_size: 20.0

      reverse_penalty: 2.0
      change_penalty: 0.05
      non_straight_penalty: 1.05
      cost_penalty: 2.0
      retrospective_penalty: 0.015
      rotation_penalty: 5.0

      analytic_expansion_ratio: 3.5
      analytic_expansion_max_length: 3.0

      # 后向安全链完成前，暂不生成倒车路径。
      allow_reverse_expansion: false

      smooth_path: true
controller_server:
  ros__parameters:
    use_sim_time: false

    # 与MPPI的model_dt=0.05严格对应。
    controller_frequency: 20.0

    min_x_velocity_threshold: 0.001
    min_y_velocity_threshold: 0.001
    min_theta_velocity_threshold: 0.001
    failure_tolerance: 0.30

    progress_checker_plugin: progress_checker
    goal_checker_plugins:
      - general_goal_checker
    controller_plugins:
      - FollowPath

    progress_checker:
      plugin: "nav2_controller::SimpleProgressChecker"
      required_movement_radius: 0.10
      movement_time_allowance: 15.0

    general_goal_checker:
      plugin: "nav2_controller::SimpleGoalChecker"
      stateful: true
      xy_goal_tolerance: 0.15
      yaw_goal_tolerance: 0.15

    FollowPath:
      plugin: "nav2_mppi_controller::MPPIController"

      motion_model: DiffDrive

      # 56 × 0.05 = 2.8秒预测范围。
      time_steps: 56
      model_dt: 0.05
      batch_size: 1500
      iteration_count: 1

      temperature: 0.30
      gamma: 0.015
      retry_attempt_limit: 1

      # 第一版保守限速，暂不允许倒车。
      vx_max: 0.25
      vx_min: 0.0
      vy_max: 0.0
      wz_max: 0.80

      vx_std: 0.12
      vy_std: 0.0
      wz_std: 0.35

      prune_distance: 1.5
      transform_tolerance: 0.20

      visualize: false

      critics:
        - ConstraintCritic
        - ObstaclesCritic
        - GoalCritic
        - GoalAngleCritic
        - PathAlignCritic
        - PathFollowCritic
        - PathAngleCritic
        - PreferForwardCritic

      ConstraintCritic:
        enabled: true
        cost_power: 1
        cost_weight: 4.0

      ObstaclesCritic:
        enabled: true
        cost_power: 1
        repulsion_weight: 1.5
        critical_weight: 20.0

        # 使用实测矩形footprint进行完整碰撞检查。
        consider_footprint: true
        collision_cost: 10000.0
        collision_margin_distance: 0.12
        near_goal_distance: 0.40

        # 必须与局部Costmap的膨胀层一致。
        inflation_radius: 0.55
        cost_scaling_factor: 3.0

      GoalCritic:
        enabled: true
        cost_power: 1
        cost_weight: 5.0
        threshold_to_consider: 1.4

      GoalAngleCritic:
        enabled: true
        cost_power: 1
        cost_weight: 3.0
        threshold_to_consider: 0.5

      PathAlignCritic:
        enabled: true
        cost_power: 1
        cost_weight: 10.0
        max_path_occupancy_ratio: 0.07
        trajectory_point_step: 4
        threshold_to_consider: 0.5
        offset_from_furthest: 20
        use_path_orientations: true

      PathFollowCritic:
        enabled: true
        cost_power: 1
        cost_weight: 5.0
        offset_from_furthest: 6
        threshold_to_consider: 1.4

      PathAngleCritic:
        enabled: true
        cost_power: 1
        cost_weight: 2.0
        offset_from_furthest: 4
        threshold_to_consider: 0.5
        max_angle_to_furthest: 1.0
        forward_preference: true

      PreferForwardCritic:
        enabled: true
        cost_power: 1
        cost_weight: 1.5
        threshold_to_consider: 0.5

velocity_smoother:
  ros__parameters:
    use_sim_time: false

    smoothing_frequency: 20.0
    scale_velocities: false

    # Use fused odometry feedback instead of assuming commanded velocity.
    feedback: CLOSED_LOOP
    odom_topic: /odometry/filtered
    odom_duration: 0.20

    # Keep the first navigation version forward-only and consistent with MPPI.
    max_velocity: [0.25, 0.0, 0.80]
    min_velocity: [0.0, 0.0, -0.80]

    # Conservative acceleration for the heavy skid-steer platform.
    max_accel: [0.25, 0.0, 0.60]
    max_decel: [-0.35, 0.0, -0.80]

    deadband_velocity: [0.02, 0.0, 0.05]
    velocity_timeout: 0.30

smoother_server:
  ros__parameters:
    use_sim_time: false

    costmap_topic: global_costmap/costmap_raw
    footprint_topic: global_costmap/published_footprint
    robot_base_frame: base_footprint
    transform_tolerance: 0.30

    smoother_plugins:
      - simple_smoother

    simple_smoother:
      plugin: "nav2_smoother::SimpleSmoother"
      tolerance: 1.0e-10
      max_its: 1000
      w_data: 0.2
      w_smooth: 0.3
      do_refinement: true

behavior_server:
  ros__parameters:
    use_sim_time: false

    costmap_topic: local_costmap/costmap_raw
    footprint_topic: local_costmap/published_footprint
    cycle_frequency: 10.0

    # First navigation version: do not load reverse behaviors.
    behavior_plugins:
      - spin
      - wait

    spin:
      plugin: "nav2_behaviors/Spin"
    wait:
      plugin: "nav2_behaviors/Wait"

    global_frame: odom
    robot_base_frame: base_footprint
    transform_tolerance: 0.20
    simulate_ahead_time: 2.0
    max_rotational_vel: 0.60
    min_rotational_vel: 0.15
    rotational_acc_lim: 0.60

bt_navigator:
  ros__parameters:
    use_sim_time: false

    global_frame: map
    robot_base_frame: base_footprint
    odom_topic: /odometry/filtered
    bt_loop_duration: 10
    default_server_timeout: 20
    wait_for_service_timeout: 1000

    # Project trees make all recovery actions forward-only.
    default_nav_to_pose_bt_xml: "/home/wheeltec/inspection_robot_ws/install/inspection_robot_navigation/share/inspection_robot_navigation/behavior_trees/navigate_to_pose_forward_only.xml"
    default_nav_through_poses_bt_xml: "/home/wheeltec/inspection_robot_ws/install/inspection_robot_navigation/share/inspection_robot_navigation/behavior_trees/navigate_through_poses_forward_only.xml"

    plugin_lib_names:
      - nav2_compute_path_to_pose_action_bt_node
      - nav2_compute_path_through_poses_action_bt_node
      - nav2_follow_path_action_bt_node
      - nav2_spin_action_bt_node
      - nav2_wait_action_bt_node
      - nav2_clear_costmap_service_bt_node
      - nav2_goal_updated_condition_bt_node
      - nav2_recovery_node_bt_node
      - nav2_pipeline_sequence_bt_node
      - nav2_rate_controller_bt_node
      - nav2_round_robin_node_bt_node
      - nav2_remove_passed_goals_action_bt_node

bt_navigator_navigate_to_pose_rclcpp_node:
  ros__parameters:
    use_sim_time: false

bt_navigator_navigate_through_poses_rclcpp_node:
  ros__parameters:
    use_sim_time: false

waypoint_follower:
  ros__parameters:
    use_sim_time: false
    loop_rate: 20
    stop_on_failure: true
    waypoint_task_executor_plugin: wait_at_waypoint

    wait_at_waypoint:
      plugin: "nav2_waypoint_follower::WaitAtWaypoint"
      enabled: true
      waypoint_pause_duration: 1000
